# OpenRouter API key (the app currently reads this through OPENAI_API_KEY).
OPENAI_API_KEY=your-openrouter-api-key

# Chat model identifier on OpenRouter.
MODEL_ID=google/gemini-3.8-flash

# Optional vision model override. Leave commented to use MODEL_ID for screenshots.
# The selected model must support image input.
# VISION_MODEL_ID=google/gemini-3.8-flash

# Optional persistent memory directory. Relative paths are resolved from the project root.
# Defaults to .deep_web_agent/memory.
DEEP_WEB_AGENT_MEMORY_DIR=.deep_web_agent/memory
